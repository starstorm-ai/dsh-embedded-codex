new file mode 100644
index 0000000000000000000000000000000000000000..b87a5afbe6f674cb4ec1ebb276ec84cd7af18273
--- /dev/null
+++ b/.pnpmfile.cjs
@@ -0,0 +1,10 @@
+// The embedded upstream checkout must not replace the developer's Git hooks.
+// Apply before pnpm's automatic dependency check, including `pnpm dev`.
+module.exports = {
+  hooks: {
+    updateConfig(config) {
+      process.env.CI = 'true'
+      return config
+    },
+  },
+}
