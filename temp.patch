+      .toEqual(messages)
+    expect(ledger.eventNodes.flatMap(node => node.kind === 'tool-result' ? [node.callId] : [])).toEqual(['codex:b', 'codex:a'])
+
+    const partial = enrichNativeHistory(entries.filter(entry => entry.event.seq >= 5), snapshots)
