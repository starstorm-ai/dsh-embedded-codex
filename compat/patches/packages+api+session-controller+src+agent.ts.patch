+/** Convert resolved Agent creation options into a complete model selection. */
+function requiredModelSelection(options: AgentOptions): AgentModelSelection {
+  if (options.provider === undefined || options.model === undefined) {
+    throw new Error('api-session: an Agent Runtime model default requires provider and model')
+  }
+  return {
+    provider: options.provider,
+    model: options.model,
+    ...(options.reasoningEffort === undefined ? {} : { reasoningEffort: options.reasoningEffort }),
+  }
