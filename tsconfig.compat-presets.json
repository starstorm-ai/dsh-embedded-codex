{
  "extends": "./upstream/deepseek-harness/tsconfig.base.json",
  "compilerOptions": {
    "declarationMap": false,
    "rootDir": "compat/generated/packages/preset/agent-presets/src",
    "outDir": "lib/types/compat/agent-presets",
    "tsBuildInfoFile": "lib/tsconfig.compat-presets.tsbuildinfo",
    "typeRoots": [
      "./compat/types",
      "./node_modules/@types"
    ],
    "types": ["node", "dsh-agent-runtime"]
  },
  "include": ["compat/generated/packages/preset/agent-presets/src/**/*.ts"],
  "exclude": ["compat/generated/packages/preset/agent-presets/src/invariant.ts"],
  "references": [
    { "path": "./upstream/deepseek-harness/vendor/cosmokit" },
    { "path": "./upstream/deepseek-harness/vendor/cordis" },
    { "path": "./upstream/deepseek-harness/vendor/schemastery" },
    { "path": "./upstream/deepseek-harness/vendor/include" },
    { "path": "./upstream/deepseek-harness/vendor/loader" },
    { "path": "./upstream/deepseek-harness/packages/core/agent" },
    { "path": "./upstream/deepseek-harness/packages/core/scope" },
    { "path": "./upstream/deepseek-harness/packages/core/session" },
    { "path": "./upstream/deepseek-harness/packages/session/session-projection" },
    { "path": "./upstream/deepseek-harness/packages/core/system-prompt" },
    { "path": "./upstream/deepseek-harness/packages/core/tools" },
    { "path": "./upstream/deepseek-harness/packages/typert/protocol" },
    { "path": "./upstream/deepseek-harness/packages/settings/settings" },
    { "path": "./upstream/deepseek-harness/packages/util/atomic-write" },
    { "path": "./upstream/deepseek-harness/packages/util/home-paths" },
    { "path": "./upstream/deepseek-harness/packages/runtime-diagnostics/invariants" }
  ]
}
