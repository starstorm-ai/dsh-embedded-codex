    { "path": "./upstream/deepseek-harness/packages/llm/llm" },
    { "path": "./upstream/deepseek-harness/packages/session/session-projection" },
    { "path": "./upstream/deepseek-harness/packages/session/session-title" },
    { "path": "./upstream/deepseek-harness/packages/subagent/subagent" },
    { "path": "./upstream/deepseek-harness/packages/util/brand" },
    { "path": "./upstream/deepseek-harness/packages/util/crypto" },
    { "path": "./upstream/deepseek-harness/packages/util/workspace-path" },
    { "path": "./upstream/deepseek-harness/packages/workspace/workspace" },
    { "path": "./upstream/deepseek-harness/packages/typert/protocol" }
  ]
