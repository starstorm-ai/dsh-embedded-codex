  "compilerOptions": {
    "declarationMap": false,
    "rootDir": "compat/generated/packages/api/session-controller/src",
    "outDir": "lib/types/compat/session-controller-client",
    "tsBuildInfoFile": "lib/tsconfig.compat-session-client.tsbuildinfo",
