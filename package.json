{
  "name": "dsh-embedded-codex",
  "description": "Preset-selected Codex App Server Agent Runtime for DeepSeek Harness",
  "version": "0.2.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compat/agent-registry": {
      "types": "./lib/types/compat/agent-registry/index.d.ts",
      "default": "./lib/compat/agent-registry.js"
    },
    "./compat/agent-preset-registry": {
      "types": "./lib/types/compat/agent-preset-registry/index.d.ts",
      "default": "./lib/compat/agent-preset-registry.js"
    },
    "./compat/config-editor": {
      "types": "./lib/types/compat/config-editor/index.d.ts",
      "default": "./lib/compat/config-editor.js"
    },
    "./compat/permission-presets": {
      "types": "./lib/types/compat/permission-presets/index.d.ts",
      "default": "./lib/compat/permission-presets.js"
    },
    "./compat/session-controller": {
      "types": "./lib/types/compat/session-controller/index.d.ts",
      "default": "./lib/compat/session-controller.js"
    },
    "./compat/ui-permission-presets": {
      "types": "./lib/types/compat/ui/ui-permission-presets.d.ts",
      "default": "./lib/compat/ui-permission-presets.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./compat/runtime-support": {
      "types": "./lib/types/compat/runtime-support.d.ts",
      "default": "./lib/compat/runtime-support.js"
    },
    "./compat/ui-chat": {
      "types": "./lib/types/compat/ui/ui-chat.d.ts",
      "default": "./lib/compat/ui-chat.js"
    },
    "./compat/ui-trajectory": {
      "types": "./lib/types/compat/ui/ui-trajectory.d.ts",
      "default": "./lib/compat/ui-trajectory.js"
    },
    "./compat/transcript": {
      "types": "./lib/types/transcript.d.ts",
      "default": "./lib/compat/transcript.js"
    },
    "./compat/transcript-client": {
      "types": "./lib/types/client/history.d.ts",
      "default": "./lib/compat/transcript-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/compat/*.js",
    "lib/compat/*.js.map",
    "lib/types/**/*.d.ts",
    "lib/protocol/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
